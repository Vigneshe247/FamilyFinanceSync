# =========================================================
# FAMILY FINANCE SYNC — ENVIRONMENT VARIABLE SPECIFICATION
# NEVER COMMIT REAL KEYS, SIGNER KEYS, OR .env TO GIT REPOSITORY
# =========================================================

# ---------------------------------------------------------
# 1. FRONTEND CLIENT CONFIGURATION (Safe for browser / Vite)
# ---------------------------------------------------------
VITE_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
VITE_APP_ENV="development"

# Sentry Error Monitoring (Optional - Client Safe DSN)
VITE_SENTRY_DSN="https://[YOUR_KEY]@[HOST].ingest.sentry.io/[PROJECT_ID]"

# EmailJS Service Configuration (Frontend Client Safe)
VITE_EMAILJS_SERVICE_ID="service_55smup6"
VITE_EMAILJS_TEMPLATE_ID="template_xxxxxxx"
VITE_EMAILJS_PUBLIC_KEY="xxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------
# 2. SUPABASE EDGE FUNCTIONS SECRETS (Optional Server-side)
# Set via: npx supabase secrets set KEY=VALUE
# ---------------------------------------------------------
# EMAILJS_SERVICE_ID="service_55smup6"
# EMAILJS_TEMPLATE_ID="template_xxxxxxx"
# EMAILJS_PUBLIC_KEY="xxxxxxxxxxxxxxxxxxxx"
# EMAILJS_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------
# 3. SENTRY BUILD-TIME METRICS & SOURCEMAPS (CI / Build Only)
# ---------------------------------------------------------
# SENTRY_AUTH_TOKEN="[YOUR_SENTRY_AUTH_TOKEN]"
# SENTRY_ORG="[YOUR_SENTRY_ORG_SLUG]"
# SENTRY_PROJECT="[YOUR_SENTRY_PROJECT_SLUG]"

# ---------------------------------------------------------
# 4. DATABASE DIRECT CONNECTION (CLI / DB Push Only)
# NEVER prefix these with VITE_ or import into React!
# ---------------------------------------------------------
# SUPABASE_DB_HOST="db.[YOUR_PROJECT_REF].supabase.co"
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER="postgres"
# SUPABASE_DB_PASSWORD="[YOUR_DATABASE_PASSWORD]"
# SUPABASE_DB_NAME="postgres"
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
