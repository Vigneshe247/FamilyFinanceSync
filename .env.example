# =========================================================
# FAMILY FINANCE SYNC — ENVIRONMENT VARIABLE SPECIFICATION
# NEVER COMMIT REAL KEYS, SIGNER KEYS, OR .env TO GIT REPOSITORY
# =========================================================

# ---------------------------------------------------------
# 1. FRONTEND CLIENT CONFIGURATION (Safe for browser / Vite)
# ---------------------------------------------------------
VITE_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
VITE_APP_ENV="development"

# Firebase Client Configuration (financesync-4568b)
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="financesync-4568b.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="financesync-4568b"
VITE_FIREBASE_STORAGE_BUCKET="financesync-4568b.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# ---------------------------------------------------------
# 2. BACKEND / SERVER FUNCTIONS ONLY (Never expose to browser)
# ---------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
DATABASE_URL="postgresql://postgres:[DATABASE_PASSWORD]@[HOST]:5432/postgres"

# ---------------------------------------------------------
# 3. MIGRATION UTILITY ONLY (CLI / Test Migration)
# NEVER prefix these with VITE_ or import them into React!
# ---------------------------------------------------------
SUPABASE_DB_HOST="db.[YOUR_PROJECT_REF].supabase.co"
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER="postgres"
SUPABASE_DB_PASSWORD="[YOUR_DATABASE_PASSWORD]"
SUPABASE_DB_NAME="postgres"

FIREBASE_HASH_SIGNER_KEY="[YOUR_BASE64_SIGNER_KEY]"
FIREBASE_HASH_SALT_SEPARATOR="Bw=="
FIREBASE_HASH_ROUNDS=8
FIREBASE_HASH_MEM_COST=14

# ---------------------------------------------------------
# 4. SENTRY ERROR & PERFORMANCE MONITORING
# ---------------------------------------------------------
VITE_SENTRY_DSN="https://[YOUR_KEY]@[HOST].ingest.sentry.io/[PROJECT_ID]"
SENTRY_AUTH_TOKEN="[YOUR_SENTRY_AUTH_TOKEN]"
SENTRY_ORG="[YOUR_SENTRY_ORG_SLUG]"
SENTRY_PROJECT="[YOUR_SENTRY_PROJECT_SLUG]"

# ---------------------------------------------------------
# 5. RESEND EMAIL SERVICE (Family Invitations & Alerts)
# ---------------------------------------------------------
VITE_RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
